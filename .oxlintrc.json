{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "jsPlugins": ["./bin/style.mjs"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-new-wrappers": "error",
    "no-param-reassign": "error",
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-cycle": [
      "error",
      {
        "ignoreTypes": false
      }
    ],
    "eqeqeq": "error",
    "no-else-return": "error",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-lonely-if": "error",
    "no-lone-blocks": "error",
    "no-new": "error",
    "no-return-assign": "error",
    "no-throw-literal": "error",
    "no-unneeded-ternary": "error",
    "no-useless-call": "error",
    "no-useless-computed-key": "error",
    "no-useless-concat": "error",
    "no-useless-constructor": "error",
    "no-warning-comments": "error",
    "object-shorthand": "error",
    "prefer-object-has-own": "error",
    "prefer-promise-reject-errors": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "Reflect",
        "property": "apply"
      },
      {
        "object": "Reflect",
        "property": "get"
      },
      {
        "object": "vi",
        "property": "mock"
      },
      {
        "object": "vi",
        "property": "doMock"
      }
    ],
    "typescript/ban-ts-comment": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-function-type": "error",
    "unicorn/error-message": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/no-unreadable-iife": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/no-useless-switch-case": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/throw-new-error": "error",
    "oxc/branches-sharing-code": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-barrel-file": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-mutable-exports": "error",
    "import/no-self-import": "error",
    "style/no-comment": "error"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "import/no-relative-parent-imports": "error",
        "no-console": [
          "error",
          {
            "allow": ["error"]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(workflow|trace|git|folder|context|graph|env|disk|forge|store|session|sandbox|docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "values import values only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/workflow.ts", "src/folder.ts", "src/context.ts", "src/graph.ts", "src/trace.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(git|env|disk|forge|store|session|sandbox|docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "logic imports values and logic only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/env.ts", "src/disk.ts", "src/git.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(forge|store|session|sandbox|docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "libs import logic and below"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/forge.ts", "src/store.ts", "src/session.ts", "src/sandbox.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "ports import libs and below"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/docker.ts", "src/remote.ts", "src/github.ts", "src/harnesses.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(engine|services|main|instance|status)\\.ts$",
                "message": "adapters import ports and below"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/engine.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(docker|remote|github|harnesses|services|main|instance|status)\\.ts$",
                "message": "engine imports ports and below, never adapters"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/services.ts", "src/main.ts", "src/instance.ts", "src/status.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["bench/**", "tune/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../bin/**", "../studio/**"],
                "message": "bench and tune import src only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["bench/drive.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../bin/**", "!../bin/resume.ts", "../studio/**"],
                "message": "bench and tune import src only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tune/propose.ts", "tune/skill.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../bin/**", "!../bin/bench.ts", "!../bin/resume.ts", "!../bin/tune.ts", "../studio/**"],
                "message": "bench and tune import src only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/trace.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(git|env|disk|forge|store|session|docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "logic imports values and logic only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/git.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\./(forge|store|session|docker|remote|github|harnesses|engine|services|main|instance|status)\\.ts$",
                "message": "libs import logic and below"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**", "harnesses/**", "bin/**", "bench/**", "tune/**", "studio/src/**"],
      "rules": {
        "style/verb-first": "error",
        "style/no-of-for": "error",
        "style/unique-export": "error",
        "style/retired-word": "error"
      }
    },
    {
      "files": ["examples/**", "tests/**", "studio/*.ts"],
      "rules": {
        "style/no-of-for": "error"
      }
    }
  ],
  "ignorePatterns": ["**/node_modules/**", "studio-lab/**", "research/**"]
}
