  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
