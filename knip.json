{
  "entry": [
    "src/main.ts!",
    "bin/*.{ts,mjs}!",
    "bench/*.ts!",
    "tune/*.ts!",
    "tests/**/*.test.ts",
    "tests/setup/*.ts",
    "examples/*/scripts/**/*.mjs",
    "studio/dev.ts!",
    "studio/src/main.tsx!",
    "studio/vite.config.ts!"
  ],
  "project": [
    "src/**/*.ts!",
    "harnesses/*.ts!",
    "bin/**!",
    "bench/*.ts!",
    "tune/**!",
    "studio/src/**/*.{ts,tsx}!",
    "studio/*.ts!",
    "examples/*/scripts/**"
  ],
  "vitest": false,
  "ignoreBinaries": ["continue", "codex", "du", "mkfifo"],
  "ignoreDependencies": [
    "react",
    "react-dom",
    "jotai",
    "@xyflow/react",
    "fumadocs-core",
    "@tailwindcss/vite",
    "@vitejs/plugin-react",
    "agentation",
    "d3-scale",
    "@observablehq/plot"
  ]
}
