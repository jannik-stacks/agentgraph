{
  "entry": [
    "src/main.ts",
    "bin/*.{ts,mjs}",
    "tests/**/*.test.ts",
    "tests/setup/*.ts",
    "examples/*/scripts/**/*.mjs",
    "studio/dev.ts",
    "studio/src/main.tsx",
    "studio/vite.config.ts"
  ],
  "project": ["src/**/*.ts", "bin/**", "studio/**/*.{ts,tsx}", "examples/*/scripts/**"],
  "vitest": false,
  "ignoreBinaries": ["continue", "codex"],
  "ignoreDependencies": [
    "react",
    "react-dom",
    "jotai",
    "@xyflow/react",
    "fumadocs-core",
    "@tailwindcss/vite",
    "@vitejs/plugin-react",
    "agentation",
    "d3-scale"
  ]
}
