# Not yet used. Runs the infra/local compose stack (LiteLLM + Postgres) on 127.0.0.1:4000.
# Needs several GB of RAM; too heavy next to other daemons on a 3.7 GB box.
[Unit]
Description=LiteLLM proxy (compose)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/bothub/infra/local
ExecStart=/usr/bin/docker compose up -d --wait litellm
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
