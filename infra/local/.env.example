# Copy to infra/local/.env and fill in. Placeholders only; never commit real values.

# LiteLLM admin key (must start with sk-). Also the admin UI password. Never given to a bot.
LITELLM_MASTER_KEY=sk-local-change-me
POSTGRES_PASSWORD=litellm-local
# litellm.config.yaml (subscription, API key, local) or litellm.offline.yaml (everything local).
LITELLM_CONFIG=litellm.config.yaml

# Upstream provider keys. They live only in the proxy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Upstream models behind the aliases (LiteLLM provider/model form).
BOTHUB_MODEL_SMART=chatgpt/gpt-6.1-sol
BOTHUB_MODEL_WRITER=chatgpt/gpt-6.1-sol
BOTHUB_MODEL_REVIEW=anthropic/claude-opus-5-5
BOTHUB_MODEL_LOCAL=ollama_chat/qwen3.5:4b

# Ollama as seen from containers. macOS (native Ollama): the defaults. Linux with the ollama
# profile: OLLAMA_API_BASE=http://ollama:11434 and OLLAMA_HOST_ADDR=ollama:11434.
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_HOST_ADDR=host.docker.internal:11434

# What harness adapters read. The runner maps BOTHUB_LLM_API_KEY_<BOT> to BOTHUB_LLM_API_KEY per run.
BOTHUB_LLM_BASE_URL=http://127.0.0.1:4000
BOTHUB_LLM_API_KEY_IMPLEMENTOR=
BOTHUB_LLM_API_KEY_DOCS_EDITOR=
BOTHUB_LLM_API_KEY_REVIEWER=
BOTHUB_LLM_API_KEY_FACT_CHECKER=
BOTHUB_LLM_API_KEY_GARDENER=
BOTHUB_LLM_API_KEY_TRIAGER=

# Decision API for checks (Ollama /v1/systemone, not OpenAI-shaped). Inside a sandbox the URL
# is http://ollama.internal:11434 (the relay's alias; Ollama refuses other host names).
# A model without a :tag, such as luna, is a LiteLLM alias instead: decide calls then go to
# BOTHUB_LLM_BASE_URL as chat completions, and the URL below is unused.
BOTHUB_DECIDE_URL=http://127.0.0.1:11434
BOTHUB_DECIDE_MODEL=tev1:0.8b

# GitHub App. Without these the runner stays in log mode and applies nothing.
BOTHUB_APP_ID=
BOTHUB_APP_KEY_FILE=
BOTHUB_INSTALLATION_ID=
BOTHUB_DATA=
