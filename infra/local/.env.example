# Copy to infra/local/.env and fill in. Placeholders only; never commit real values.

# LiteLLM admin key (must start with sk-). Also the admin UI password. Never given to a bot.
LITELLM_MASTER_KEY=sk-local-change-me
POSTGRES_PASSWORD=litellm-local
# litellm.config.yaml (subscription, API key, local) or litellm.offline.yaml (everything local).
LITELLM_CONFIG=litellm.config.yaml

# Upstream provider keys. They live only in the proxy.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Upstream models behind the aliases (LiteLLM provider/model form).
AGENTGRAPH_MODEL_SMART=chatgpt/gpt-6.1-sol
AGENTGRAPH_MODEL_WRITER=chatgpt/gpt-6.1-sol
AGENTGRAPH_MODEL_LOCAL=ollama_chat/qwen3.5:4b

# Ollama as seen from containers. macOS (native Ollama): the defaults. Linux with the ollama
# profile: OLLAMA_API_BASE=http://ollama:11434 and OLLAMA_HOST_ADDR=ollama:11434.
OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_HOST_ADDR=host.docker.internal:11434
